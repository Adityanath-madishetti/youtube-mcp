# --- Google OAuth app credentials (yours, once — end users never see these) ---
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Public URL this server is reachable at, no trailing slash.
# Must exactly match what you register as the Authorized redirect URI in
# Google Cloud (that URI is this value + "/auth/callback").
BASE_URL=https://your-host.example.com

# Signs the JWTs this server issues to Claude. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep stable across restarts and rotate independently of GOOGLE_CLIENT_SECRET.
JWT_SIGNING_KEY=change-me

# Encrypts OAuth tokens at rest on disk. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this forces every user to re-authenticate.
STORAGE_ENCRYPTION_KEY=change-me

# --- Optional ---
# Where encrypted OAuth state is persisted. MUST be a mounted, persistent disk
# in production — an ephemeral filesystem silently logs everyone out on deploy.
STORAGE_PATH=/data/oauth

# Port the HTTP server listens on.
PORT=8000

# Default in-process cache TTL (seconds) for values without a specific TTL.
CACHE_TTL_SECONDS=900
